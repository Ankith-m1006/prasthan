{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prasthan.local/schemas/lang.json",
  "$defs": {
    "lang": {
      "enum": [
        "kn-IN",
        "ta-IN",
        "te-IN",
        "hi-IN",
        "od-IN",
        "bn-IN",
        "en-IN"
      ]
    },
    "mode": {
      "enum": [
        "bus",
        "train",
        "air"
      ]
    },
    "source": {
      "enum": [
        "live",
        "mock",
        "fallback",
        "seeded",
        "context_dev"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "localText": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/lang"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
