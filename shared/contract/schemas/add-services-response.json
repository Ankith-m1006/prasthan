{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prasthan.local/schemas/add-services-response.json",
  "title": "AddServicesResponse",
  "type": "object",
  "required": [
    "services",
    "alert",
    "notified",
    "demandAfter"
  ],
  "properties": {
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "service.json"
      }
    },
    "alert": {
      "$ref": "alert.json"
    },
    "notified": {
      "type": "integer",
      "minimum": 0
    },
    "demandAfter": {
      "type": "object",
      "required": [
        "want",
        "have",
        "gap"
      ],
      "properties": {
        "want": {
          "type": "number"
        },
        "have": {
          "type": "number"
        },
        "gap": {
          "type": "number"
        }
      }
    }
  }
}
