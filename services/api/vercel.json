    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{src/**/*.json,../../seed/**,../../config/flagsmith/**,../../apps/mobile/assets/audio/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
