{
  "name": "prasthan-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/mukta": "^0.4.1",
    "@expo-google-fonts/noto-sans-bengali": "^0.4.4",
    "@expo-google-fonts/noto-sans-devanagari": "^0.4.2",
    "@expo-google-fonts/noto-sans-kannada": "^0.4.3",
    "@expo-google-fonts/noto-sans-oriya": "^0.4.2",
    "@expo-google-fonts/noto-sans-tamil": "^0.4.3",
    "@expo-google-fonts/noto-sans-telugu": "^0.4.2",
    "@expo-google-fonts/tiro-kannada": "^0.4.0",
    "@expo/metro-runtime": "~58.0.17",
    "expo": "~58.0.26",
    "expo-audio": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-status-bar": "~58.0.5",
    "flagsmith": "10.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/jest": "~30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --silent",
    "export:web": "expo export --platform web",
    "serve-web": "npx --yes serve -s dist",
    "build:web": "expo export --platform web",
    "deploy:web": "node scripts/prepare-vercel.mjs && cd dist && vercel deploy --prod --yes"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "modulePaths": ["<rootDir>/node_modules"],
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ]
  }
}
