# Copy to apps/mobile/.env (Expo reads env from this folder). Nothing here is secret.
# API url; leave empty to run fully offline on bundled demo data.
EXPO_PUBLIC_API_URL=http://localhost:8787
# 1 = never call the api (bundled seed data only)
EXPO_PUBLIC_APP_MOCK=0
# Flagsmith CLIENT-SIDE environment key (public by design, safe in the bundle). Set => the app reads live flags
# straight from Flagsmith; empty => coded defaults + demo switches. Never put the server-side "ser." key here.
EXPO_PUBLIC_FLAGSMITH_ENV_KEY=
