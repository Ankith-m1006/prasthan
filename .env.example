# Names only. Copy to .env and fill in. NEVER commit .env. NEVER print these values.
# Every service has a mock mode, so the app runs with all of these empty.

# --- global ---
MOCK_ALL=0                      # 1 = every external service uses its mock (offline demo)
PORT=8787                       # API port
ROLE=all                        # all | api | voice  (k8s runs api and voice as two deployments)
VOICE_URL=http://localhost:8787 # where the api finds the voice service (k8s: http://prasthan-voice:8787)
OPS_TOKEN=                      # shared secret for POST /v1/ops/* (NudgeBee runbook / demo script)

# --- Sarvam AI ---
SARVAM_API_KEY=
SARVAM_MODE=live                # live | mock

# --- Flagsmith ---
FLAGSMITH_SERVER_KEY=           # server-side environment key (ser.xxx), secret
FLAGSMITH_ENV_KEY_CLIENT=       # client-side environment key (not secret, but keep it here anyway)
FLAGSMITH_ADMIN_API_KEY=        # Organisation API key, for the import script and the ops flip only
FLAGSMITH_PROJECT_ID=
FLAGSMITH_ENVIRONMENT_API_KEY=  # environment key used by the Admin API to flip feature states
FLAGSMITH_MODE=live             # live | mock (mock = coded defaults from config/flagsmith/flags.json)

# --- NudgeBee ---
NUDGEBEE_API_TOKEN=             # sk-nb-..., only for nbctl on the laptop, never in the app or the cluster
NUDGEBEE_ACCOUNT_ID=

# --- context.dev (optional helper, not a sponsor) ---
CONTEXT_DEV_API_KEY=            # UNVERIFIED variable name: check context.dev docs; rename here + in code if the SDK expects another name
CONTEXT_DEV_MODE=off            # off | live

# --- app (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:8787   # phone on same Wi-Fi: http://<laptop-LAN-IP>:8787
EXPO_PUBLIC_APP_MOCK=0                      # 1 = app uses bundled seed data, no API at all
